"\nconst bundle=JSON.parse(document.getElementById('bundle').textContent);\nconst frame=document.getElementById('site');\nconst urls={};for(const [path,a] of Object.entries(bundle.assets)){const bytes=Uint8Array.from(atob(a.data),c=>c.charCodeAt(0));urls[path]=URL.createObjectURL(new Blob([bytes],{type:a.mime}));}\nlet current='/';\nfunction render(){let value=location.hash.slice(1)||'/';let [route,anchor='']=value.split('#');if(!bundle.pages[route])route='/';current=route;\nlet html=bundle.pages[route];for(const [path,url]of Object.entries(urls))html=html.split(path).join(url);\nhtml=html.replace('<link rel=\"stylesheet\" href=\"/style.css\">','<style>'+bundle.css+'</style>').replace('<script src=\"/app.js\" defer></scr'+'ipt>','');\nconst init='window.__route='+JSON.stringify(route)+';window.__anchor='+JSON.stringify(anchor)+';';\nconst bridge=`document.addEventListener('click',e=>{if(e.defaultPrevented)return;const a=e.target.closest('a');if(!a)return;const href=a.getAttribute('href');if(!href)return;if(href.startsWith('/')){e.preventDefault();parent.postMessage({kind:'navigate',href},'*');}else if(href.startsWith('#')){e.preventDefault();document.getElementById(href.slice(1))?.scrollIntoView();}else if(/^https?:/.test(href)){a.target='_blank';a.rel='noopener';}});requestAnimationFrame(()=>document.getElementById(window.__anchor)?.scrollIntoView());parent.postMessage({kind:'title',title:document.title},'*');`;\nhtml=html.replace('\n<script>\n/* HeyJarvis Concierge — Production-Ready Dental Widget\n *\n * Embed on any site:\n *   <script async src=\"https://YOUR-HOST/widget.js\">"