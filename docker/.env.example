# =============================================================================
# HeyJarvis — AI Dental Concierge Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-string-in-production
DEBUG=True

# Database
DATABASE_URL=postgres://heyjarvis:heyjarvis@postgres:5432/heyjarvis

# Redis
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# AI / LLM Configuration
# -----------------------------------------------------------------------------
# Provider: "openai" or "anthropic"
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Google OAuth (for Gmail integration)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# Provider type: "gmail" or "smtp"
EMAIL_PROVIDER_TYPE=gmail

# Gmail OAuth2 credentials (used when EMAIL_PROVIDER_TYPE=gmail)
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# SMTP settings (used when EMAIL_PROVIDER_TYPE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# Sender identity
DEFAULT_FROM_EMAIL=noreply@heyjarvis.com
DEFAULT_FROM_NAME=HeyJarvis

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001
