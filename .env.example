# HeyJarvis Concierge — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8000
API_URL=http://localhost:8000
WIDGET_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
ENCRYPTION_KEY=change-me-to-a-32-char-string-for-aes-gcm

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=data/saas.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/heyjarvis

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
# Production example:
# CORS_ORIGINS=https://app.heyjarvis.ai,https://your-customer-site.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── AI Provider (Gemini primary, Groq optional fallback) ─────────────────────
# Get a key at https://aistudio.google.com/apikey. Without it, AI features
# degrade to rule-based behaviour (no crash).
GEMINI_API_KEY=your-gemini-api-key-here
CONCIERGE_MODEL=gemini-3.8-flash
CONCIERGE_FALLBACK_MODEL=gemini-3.5-flash-lite
CONCIERGE_LLM_TIMEOUT=12
# Set to 0 to turn all LLM calls off (tests, offline demos):
CONCIERGE_USE_LLM=1
# Optional second provider if Gemini fails:
# GROQ_API_KEY=
# CONCIERGE_GROQ_MODEL=openai/gpt-oss-120b

# ── Email / SMTP (HeyJarvis Managed Default) ──────────────────────────────────
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=your-default-sender@heyjarvis.ai
DEFAULT_SMTP_PASSWORD=your-default-smtp-password
DEFAULT_SMTP_FROM=HeyJarvis <noreply@heyjarvis.ai>
DEFAULT_SMTP_REPLY_TO=support@heyjarvis.ai

# ── Google sign-in for clinic mailboxes (optional; app passwords work without it) ─
# OAuth client (Web) redirect URI: {APP_URL}/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Follow-up scheduler ──────────────────────────────────────────────────────
# Every N seconds: pull patient replies from each connected clinic mailbox and
# draft any cadence follow-ups that are due. Run ONE web process with it on;
# set CONCIERGE_SCHEDULER=0 on any extra workers.
CONCIERGE_SCHEDULER=1
CONCIERGE_SCHEDULER_INTERVAL=120

# ── Core Concierge (legacy) ───────────────────────────────────────────────────
CONCIERGE_TOKEN=change-me
CONCIERGE_SINK=eml
CONCIERGE_OUTBOX=outbox
CONCIERGE_ALLOWED_ORIGINS=*
CONCIERGE_SMTP_DRYRUN=0
CONCIERGE_AUTO_CONFIRM=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry DSN (optional):
# SENTRY_DSN=https://...
