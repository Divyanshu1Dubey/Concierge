# HeyJarvis Concierge — environment variables (placeholders only; never commit real values).
# Production values belong in the hosting dashboard (e.g. Railway "Variables"). Locally, Django reads
# only the AI/email/IMAP keys from .env; database, secret key and hosts must be real env vars.

# ── Core ──────────────────────────────────────────────────────────────
DJANGO_ENV=production                 # production | development | testing
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string   # REQUIRED in production (>= 32 chars). Also signs JWTs.
DJANGO_ALLOWED_HOSTS=app.example.com  # comma-separated; no wildcard in production
APP_PUBLIC_URL=https://app.example.com    # public base URL (adds host + CORS/CSRF origin)
FRONTEND_URL=                         # only if the SPA is served from a different origin
CORS_ALLOWED_ORIGINS=                 # optional extra origins, comma-separated
CSRF_TRUSTED_ORIGINS=                 # optional extra origins, comma-separated

# ── Database (SQLite on a persistent volume) ──────────────────────────
SQLITE_PATH=/data/heyjarvis.sqlite3   # REQUIRED in production; must be on the mounted volume
# Do not set DATABASE_URL / DB_ENGINE / DB_HOST: they switch the app away from SQLite.

# ── Cache / channels / Celery (optional; local memory used when unset) ─
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Outbound email (staff notifications + "managed" practice email) ───
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=HeyJarvis Concierge <noreply@example.com>

# Alternative to EMAIL_*: e.g. Gmail with an app password (465 = SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── Inbound patient replies (optional) ───────────────────────────────
# Set the practice's Reply-To (Email settings) to this mailbox so replies can be matched to requests.
IMAP_HOST=                            # e.g. imap.gmail.com; blank = reply checking off
IMAP_USER=                            # defaults to SMTP_USER
IMAP_PASSWORD=                        # defaults to SMTP_PASSWORD
CRON_SECRET=                          # shared secret for a scheduled POST to /api/emails/inbound/check/

# ── AI provider (optional; concierge falls back to rule-based replies) ─
AI_PROVIDER=                          # gemini | groq | openai | anthropic | none (blank = first with a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite    # verified working; gemini-3.8-flash returned HTTP 503 in testing
CONCIERGE_FALLBACK_MODEL=             # optional second Gemini model
GROQ_API_KEY=
CONCIERGE_GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT_PER_PRACTICE=300
AI_TIMEOUT_SECONDS=15

# ── Feature flags ─────────────────────────────────────────────────────
ENABLE_DEMO_ACCOUNTS=false            # keep false in production; demo logins are never shown publicly
DEMO_ACCOUNT_PASSWORD=                # internal testing only, with demo mode on (no password is stored in code)
ALLOW_PUBLIC_REGISTRATION=false       # staff accounts are created by admins

# ── Security tuning (defaults are sensible) ───────────────────────────
DATA_RETENTION_DAYS=                  # used by `manage.py purge_old_data` (blank = no default)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=false
THROTTLE_LOGIN_RATE=10/min
THROTTLE_WIDGET_RATE=60/min
THROTTLE_WIDGET_SUBMIT_RATE=10/min
LOG_LEVEL=INFO
