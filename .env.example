# HeyJarvis Concierge — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8000
API_URL=http://localhost:8000
WIDGET_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
ENCRYPTION_KEY=change-me-to-a-32-char-string-for-aes-gcm

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=data/saas.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/heyjarvis

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
# Production example:
# CORS_ORIGINS=https://app.heyjarvis.ai,https://your-customer-site.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── AI Provider ───────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint:
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500

# ── Email / SMTP (HeyJarvis Managed Default) ──────────────────────────────────
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=your-default-sender@heyjarvis.ai
DEFAULT_SMTP_PASSWORD=your-default-smtp-password
DEFAULT_SMTP_FROM=HeyJarvis <noreply@heyjarvis.ai>
DEFAULT_SMTP_REPLY_TO=support@heyjarvis.ai

# ── Core Concierge (legacy) ───────────────────────────────────────────────────
CONCIERGE_TOKEN=change-me
CONCIERGE_SINK=eml
CONCIERGE_OUTBOX=outbox
CONCIERGE_ALLOWED_ORIGINS=*
CONCIERGE_SMTP_DRYRUN=0
CONCIERGE_AUTO_CONFIRM=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry DSN (optional):
# SENTRY_DSN=https://...
